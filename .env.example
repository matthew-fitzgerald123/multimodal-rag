# PostgreSQL connection
DATABASE_URL=postgresql://localhost/multimodal_rag

# Models (change to other HuggingFace model IDs as needed)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEN_MODEL=mlx-community/Mistral-7B-Instruct-v0.3-4bit

# ChromaDB storage path
CHROMA_PATH=./chroma_db

# Max image upload size in MB
MAX_IMAGE_SIZE_MB=10

# Set to "true" to skip model downloads (used in CI)
MOCK_MODE=false
